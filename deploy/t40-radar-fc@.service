[Unit]
Description=T40 UDP flight-controller link on %I
BindsTo=t40-radar-ap@%i.service
After=t40-radar-ap@%i.service
PartOf=t40-radar-ap@%i.service

[Service]
Type=exec
DynamicUser=yes
WorkingDirectory=/opt/t40-radar
ExecStart=/usr/bin/python3 -u /opt/t40-radar/radar_min_client.py --flight-mode 2 --v2-local-port 40205
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
